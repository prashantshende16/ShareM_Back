# Application Environment Configuration

# Database
# For SQLite (default development):
DATABASE_URL=sqlite:///./fo_analyzer.db
# For PostgreSQL:
# DATABASE_URL=postgresql://fo_user:fo_password@localhost:5432/fo_db

# AI Vision Provider Selection: mock, openai, gemini, claude
AI_PROVIDER=mock

# OpenAI Vision Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini Vision Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Anthropic Claude Vision Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Upload & File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

# Market Data Provider
MARKET_DATA_PROVIDER=none
